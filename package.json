{
  "name": "nutrilens",
  "version": "0.1.0",
  "private": true,
  "description": "NutriLens: AI-powered food label intelligence platform (MERN, JavaScript)",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "npm start -w server",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
