# Copy this file to ".env" in the project root and fill in the values.
# ".env" is git-ignored. NEVER commit real values to the public repository.

NODE_ENV=development
PORT=4000

# Local MongoDB (see docker-compose.yml) works for development.
# For MongoDB Atlas (free M0 cluster) paste its connection string here; it contains a password.
MONGODB_URI=mongodb://127.0.0.1:27018/nutrilens

# Origin of the React app (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# ---- Authentication (Phase 1) ----
# Secret used to sign login tokens. REQUIRED: at least 32 random characters, never reused or shared.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# How long a login lasts: a number plus m (minutes), h (hours) or d (days).
JWT_EXPIRES_IN=7d

# Login cookie settings. The cookie is always HTTP-only.
# COOKIE_SECURE defaults to false in development and true in production (HTTPS only).
# COOKIE_SAME_SITE: lax (default, recommended when the app and API share a site or the Vite proxy
# is used), strict, or none (only when the app and API are on different sites; needs
# COOKIE_SECURE=true and HTTPS).
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# Optional. Leave empty in development: Vite forwards /api to http://localhost:4000.
# In production set the full API base URL, e.g. https://your-api.example.com/api
VITE_API_BASE_URL=

# Added in later phases (not used yet): GEMINI_API_KEY, REDIS_URL
