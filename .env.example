# Copy this file to ".env" in the project root and fill in the values.
# ".env" is git-ignored. NEVER commit real values to the public repository.

NODE_ENV=development
PORT=4000

# Local MongoDB (see docker-compose.yml) works for development.
# For MongoDB Atlas (free M0 cluster) paste its connection string here; it contains a password.
MONGODB_URI=mongodb://127.0.0.1:27017/nutrilens

# Origin of the React app (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# Optional. Leave empty in development: Vite forwards /api to http://localhost:4000.
# In production set the full API URL, e.g. https://your-api.example.com/api/v1
VITE_API_BASE_URL=

# Added in later phases (not used yet): JWT_SECRET, GEMINI_API_KEY, REDIS_URL
