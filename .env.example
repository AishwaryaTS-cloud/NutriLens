# Copy this file to ".env" in the project root and fill in the values.
# ".env" is git-ignored. NEVER commit real values to the public repository.

NODE_ENV=development
PORT=4000

# Local MongoDB (see docker-compose.yml) works for development.
# For MongoDB Atlas (free M0 cluster) paste its connection string here; it contains a password.
MONGODB_URI=mongodb://127.0.0.1:27018/nutrilens

# Origin of the React app (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# ---- Authentication (Phase 1) ----
# Secret used to sign login tokens. REQUIRED: at least 32 random characters, never reused or shared.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret

# How long a login lasts: a number plus m (minutes), h (hours) or d (days).
JWT_EXPIRES_IN=7d

# Login cookie settings. The cookie is always HTTP-only.
# COOKIE_SECURE defaults to false in development and true in production (HTTPS only).
# COOKIE_SAME_SITE: lax (default, recommended when the app and API share a site or the Vite proxy
# is used), strict, or none (only when the app and API are on different sites; needs
# COOKIE_SECURE=true and HTTPS).
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# ---- Label image upload (Gemini Vision reads the image) ----
# Largest image accepted, in megabytes (1 to 10). Photos are processed in memory and never stored.
MAX_UPLOAD_MB=5

# ---- Google Gemini API (server-side only: this key is never sent to the browser) ----
# Create a free key in Google AI Studio (https://aistudio.google.com/). Do NOT enable billing.
# Without a key the app still runs: you can type label values by hand and explanations use built-in rules.
GEMINI_API_KEY=
# A Gemini model that supports image input and structured JSON output. Check availability and the
# free-tier limits for your account in AI Studio, then change this if needed.
GEMINI_MODEL=gemini-3.5-flash
# How long one Gemini request may take, in milliseconds (5000 to 120000).
GEMINI_TIMEOUT_MS=45000
# Optional safety cap on Gemini requests per day for this server (0 = no app-level cap).
# Set it below your free-tier limit if you want the app to stop before Google does.
GEMINI_DAILY_LIMIT=0

# ---- Email codes (sign-up verification and email login) ----
# Leave EMAIL_PROVIDER empty to switch email codes OFF (password login keeps working).
# gmail  = Gmail SMTP with an App Password. For local development and hosts that allow SMTP.
# brevo  = Brevo's HTTPS API (port 443). Use this on Render's free tier, which blocks SMTP ports.
# Full setup steps: docs/AUTH.md
EMAIL_PROVIDER=
# The sender address. For gmail it must be the same Gmail address as SMTP_USER.
# For brevo it must be a sender you have verified in the Brevo dashboard.
EMAIL_FROM=
# The sender name recipients see. Defaults to NutriLens.
EMAIL_FROM_NAME=
# gmail only: your Gmail address, and a Gmail App Password (needs 2-Step Verification).
# This is NOT your normal Gmail password. Spaces in the App Password are ignored.
SMTP_USER=
SMTP_PASS=
# gmail only, optional: smtp.gmail.com and 465 are the defaults (587 also works).
SMTP_HOST=
SMTP_PORT=
# brevo only: an API key created in the Brevo dashboard (SMTP & API > API Keys).
BREVO_API_KEY=
# REQUIRED when EMAIL_PROVIDER is set: secret key used to hash the 6-digit codes (HMAC-SHA-256).
# At least 32 random characters. Never reuse JWT_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates any codes that are currently waiting (they last 5 minutes anyway).
OTP_SECRET=

# ---- Sign in with Google ----
# The OAuth Web client ID from Google Cloud (looks like 1234-abc.apps.googleusercontent.com).
# A client ID is public by design; this flow has NO client secret. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
# The SAME client ID, exposed to the browser build (Vite only exposes names starting with VITE_).
# Never put a secret in a VITE_ variable.
VITE_GOOGLE_CLIENT_ID=

# ---- Running behind a reverse proxy (Render, Heroku, nginx, ...) ----
# How many proxies stand in front of the server, so rate limits see the real visitor address.
# Render: 1. Leave empty (or 0) for local development. "true" is refused on purpose, because it
# would let anyone forge their address with an X-Forwarded-For header.
# Also accepts a comma-separated list of proxy IPs/CIDRs, or loopback / linklocal / uniquelocal.
TRUST_PROXY=

# Optional. Leave empty in development: Vite forwards /api to http://localhost:4000.
# In production set the full API base URL, e.g. https://your-api.example.com/api
VITE_API_BASE_URL=

# Not used yet: REDIS_URL
