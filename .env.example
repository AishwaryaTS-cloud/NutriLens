# Copy this file to ".env" in the project root and fill in the values.
# ".env" is git-ignored. NEVER commit real values to the public repository.

NODE_ENV=development
PORT=4000

# Local MongoDB (see docker-compose.yml) works for development.
# For MongoDB Atlas (free M0 cluster) paste its connection string here; it contains a password.
MONGODB_URI=mongodb://127.0.0.1:27018/nutrilens

# Origin of the React app (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# ---- Authentication (Phase 1) ----
# Secret used to sign login tokens. REQUIRED: at least 32 random characters, never reused or shared.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret

# How long a login lasts: a number plus m (minutes), h (hours) or d (days).
JWT_EXPIRES_IN=7d

# Login cookie settings. The cookie is always HTTP-only.
# COOKIE_SECURE defaults to false in development and true in production (HTTPS only).
# COOKIE_SAME_SITE: lax (default, recommended when the app and API share a site or the Vite proxy
# is used), strict, or none (only when the app and API are on different sites; needs
# COOKIE_SECURE=true and HTTPS).
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# ---- Label image upload (Gemini Vision reads the image) ----
# Largest image accepted, in megabytes (1 to 10). Photos are processed in memory and never stored.
MAX_UPLOAD_MB=5

# ---- Google Gemini API (server-side only: this key is never sent to the browser) ----
# Create a free key in Google AI Studio (https://aistudio.google.com/). Do NOT enable billing.
# Without a key the app still runs: you can type label values by hand and explanations use built-in rules.
GEMINI_API_KEY=
# A Gemini model that supports image input and structured JSON output. Check availability and the
# free-tier limits for your account in AI Studio, then change this if needed.
GEMINI_MODEL=gemini-3.5-flash
# How long one Gemini request may take, in milliseconds (5000 to 120000).
GEMINI_TIMEOUT_MS=45000
# Optional safety cap on Gemini requests per day for this server (0 = no app-level cap).
# Set it below your free-tier limit if you want the app to stop before Google does.
GEMINI_DAILY_LIMIT=0

# Optional. Leave empty in development: Vite forwards /api to http://localhost:4000.
# In production set the full API base URL, e.g. https://your-api.example.com/api
VITE_API_BASE_URL=

# Not used yet: REDIS_URL
